# Copy to .env.local (gitignored) and fill the first block. Never commit real values.

# ── Lance fills these once ─────────────────────────────────────────────
# Supabase → Project Settings → API Keys → "Secret keys" (starts with sb_secret_)
SUPABASE_SECRET_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Dify → Knowledge → API (top right) → API Key
DIFY_DATASET_API_KEY=
# Chatwoot → Settings → Inboxes → your Website inbox → Configuration → websiteToken in the script
CHATWOOT_WEBSITE_TOKEN=
# The number in your Chatwoot URL: app.chatwoot.com/app/accounts/<THIS>/dashboard
CHATWOOT_ACCOUNT_ID=
# Who can sign in to the admin panel, comma-separated
ADMIN_EMAILS=

# ── Claude fills these during setup ────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_PUBLIC_DATASET_ID=
DIFY_INTERNAL_DATASET_ID=
DIFY_ADMIN_FAQ_DOCUMENT_ID=
CHATWOOT_BASE_URL=https://app.chatwoot.com
SITE_URL=
ADMIN_URL=
API_URL=
