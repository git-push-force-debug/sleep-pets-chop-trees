{
  "name": "sleep-pets-chop-trees",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "ingest": "tsx scripts/ingest-guide.ts",
    "dify:sync": "tsx --env-file=.env.local scripts/dify-sync.ts",
    "check:connections": "node --env-file=.env.local scripts/check-connections.mjs"
  },
  "devDependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.71",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
